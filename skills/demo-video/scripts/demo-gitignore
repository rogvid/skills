#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""The gitignore lines a demo folder needs, anchored to that folder.

    <skill-dir>/scripts/demo-gitignore <demo-dir>            # print them
    <skill-dir>/scripts/demo-gitignore <demo-dir> --check    # is git ignoring them

A take writes two kinds of file beside the storyboard. One kind is the demo —
`record.py`, the stills, `timeline.json`, `timeline.md` — small, diffable, and
between them a full account of what the demo showed without anyone watching
it. The other kind is a working file of one run: the video, the frames pulled
out of it, the per-beat evidence, the review sheets, the narration cache, the
failure dump. Those are regenerated by the next take and must not reach git.

## Why a command rather than a list to copy

The list has a footgun in it, and prose can only warn about the footgun while
a command can avoid it. Three of these patterns name a directory whose name is
common — `frames/`, `review/`, `evidence/` — so writing them bare ignores
**every** directory of that name anywhere in the repository. They have to be
anchored to the demo folder, which means they have to be written against the
folder's path relative to the repository root, which is the part somebody
copying a list gets wrong. This computes it.

The rest — `demo.mp4`, the segment parts, `.tts/` — are safe unanchored and
are printed unanchored, because a repository-wide rule for them is what a
second demo folder wants too.

## `--check`

Asks **git**, with `git check-ignore`, whether each path would be ignored —
not whether some line of text is in a `.gitignore`. The two are different
questions: a pattern can be present and overridden by a later negation, or
absent and covered by a broader rule already there. Exits `2` naming every
path that would be committed, so this can gate a commit.

It is a check and never a write: it does not edit `.gitignore`. What to ignore
repository-wide is a decision about the repository, and a demo script is not
the thing that should be making it silently.

## Exit status

`0` printing, or `0` when every path is ignored under `--check`. `2` when
`--check` finds one that is not, or when the demo folder does not exist.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

#: Written beside the storyboard and never committed. Anchored ones first,
#: because those are the ones whose bare form is wrong.
ANCHORED = ("frames/", "evidence/", "review/", "failure/", "demo-video-FAILED.md")

#: Safe as repository-wide rules, and wanted repository-wide: a second demo
#: folder needs the same three.
GLOBAL = ("demo.mp4", "*.seg.mp4", "*.seg.timeline.*", ".tts/")


def repo_root(start: Path) -> Path | None:
    """The work tree `start` is in, or None when it is not in one."""
    try:
        out = subprocess.run(
            ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return Path(out.stdout.strip())


def patterns(demo: Path, root: Path | None) -> list[str]:
    """The lines, with the demo-folder ones anchored where they can be.

    Outside a work tree there is no root to anchor against. The anchored
    patterns are then printed relative to the demo folder with a leading `/`,
    which is what they mean in a `.gitignore` *inside* that folder — a real
    layout, and the honest answer when the repository root is unknown.
    """
    if root is None:
        return [f"/{name}" for name in ANCHORED] + list(GLOBAL)
    try:
        prefix = demo.resolve().relative_to(root.resolve()).as_posix()
    except ValueError:
        return [f"/{name}" for name in ANCHORED] + list(GLOBAL)
    return [f"{prefix}/{name}" for name in ANCHORED] + list(GLOBAL)


def probes(demo: Path) -> list[Path]:
    """A concrete path per rule, for git to answer about.

    `check-ignore` matches paths, not patterns, so each rule is asked about
    through a file it is supposed to cover. The files need not exist.
    """
    return [
        demo / "frames" / "frames.md",
        demo / "evidence" / "beat-01.json",
        demo / "review" / "verdict.md",
        demo / "failure" / "last.png",
        demo / "demo-video-FAILED.md",
        demo / "demo.mp4",
        demo / "part1.seg.mp4",
        demo / "part1.seg.timeline.json",
        demo / ".tts" / "line.mp3",
    ]


def unignored(demo: Path, root: Path) -> list[Path]:
    """Which probe paths git would happily commit."""
    missed = []
    for path in probes(demo):
        done = subprocess.run(
            ["git", "-C", str(root), "check-ignore", "-q", str(path)],
            capture_output=True,
        )
        # 0 = ignored, 1 = not ignored, anything else = git could not answer,
        # which is not the same as "not ignored" and is not reported as it.
        if done.returncode == 1:
            missed.append(path)
    return missed


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("demo", help="the demo folder (the one holding record.py)")
    ap.add_argument(
        "--check",
        action="store_true",
        help="ask git whether each path is already ignored, and exit 2 if not",
    )
    args = ap.parse_args(argv)

    demo = Path(args.demo)
    if not demo.is_dir():
        print(f"{demo} is not a directory", file=sys.stderr)
        return 2

    root = repo_root(demo)
    if args.check:
        if root is None:
            print(f"{demo} is not inside a git work tree", file=sys.stderr)
            return 2
        missed = unignored(demo, root)
        if missed:
            print(
                f"{len(missed)} working file(s) of a take would be committed:",
                file=sys.stderr,
            )
            for path in missed:
                print(f"  {path}", file=sys.stderr)
            print(
                "\nAdd these to .gitignore:\n\n"
                + "\n".join(f"    {line}" for line in patterns(demo, root)),
                file=sys.stderr,
            )
            return 2
        print(f"every working file of a take under {demo} is ignored")
        return 0

    for line in patterns(demo, root):
        print(line)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Start a demo: write a ready-to-run `record.py` into a new demo folder.

    <skill-dir>/scripts/demo-new <demo-dir> [--terminal] [--url URL]

The storyboard it writes already knows where this skill is, carries the uv
header that brings Playwright, and holds a short example story to edit. Run it
with `uv run <demo-dir>/record.py`.

Where the skill is, as written into `record.py`:

- relative to the storyboard (`HERE / "../../skills/demo-video"`) when the demo
  folder and this skill are in the same git repository, so the path survives a
  clone;
- absolute otherwise.

`DEMO_VIDEO_SKILL_DIR` still overrides it at run time.

## Exit status

`0` when `record.py` was written. `1` when one already exists there - nothing
is overwritten. `2` for usage errors.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent.parent

HEADER = '''# /// script
# requires-python = ">=3.10"
# dependencies = ["playwright>=1.49"]
# ///
"""{story}"""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
_DEFAULT_SKILL_DIR = {skill_dir}
SKILL_DIR = Path(os.environ.get("DEMO_VIDEO_SKILL_DIR") or _DEFAULT_SKILL_DIR)
if not (SKILL_DIR / "helpers" / "demo_recording" / "__init__.py").exists():
    sys.exit(f"demo-video skill not found at {{SKILL_DIR}}; set DEMO_VIDEO_SKILL_DIR")
sys.path.insert(0, str(SKILL_DIR / "helpers"))
from demo_recording import {recorder}  # noqa: E402
'''

WEB_BODY = """
with Recorder(HERE{url}) as rec:
    rec.goto("/")
    rec.wait_for("body")  # better: the element that holds the page's content
    rec.caption("One sentence: what the viewer is looking at.")
    rec.hold()
    rec.shot("01-start")

    # The feature, one beat at a time: caption first, then the action, then a
    # wait on the outcome the caption promises.
    #
    # rec.caption("Type a name and the list narrows to match.")
    # rec.type_into("#search", "invoice")
    # rec.wait_for(".row")
    # rec.spotlight(".row")
    # rec.hold()
    # rec.shot("02-result")
    # rec.spotlight()

    rec.caption("A closing line that sums up the story.")
    rec.hold()
    rec.caption("")
"""

TERMINAL_BODY = """
with TerminalRecorder(HERE) as rec:
    rec.caption("One sentence: what this command is for.")
    rec.run("echo hello")  # types visibly, then presses Enter
    rec.wait_for_prompt()  # waits for the command to finish
    rec.hold()
    rec.shot("01-start")

    rec.caption("A closing line that sums up the story.")
    rec.hold()
    rec.caption("")
"""


def skill_dir_expression(demo_dir: Path) -> str:
    """How `record.py` names this skill: repo-relative when it can be."""

    def toplevel(path: Path) -> Path | None:
        try:
            out = subprocess.run(
                ["git", "-C", str(path), "rev-parse", "--show-toplevel"],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()
        except (OSError, subprocess.CalledProcessError):
            return None
        return Path(out).resolve() if out else None

    repo = toplevel(demo_dir)
    if repo is not None and repo == toplevel(SKILL_DIR):
        rel = Path(os.path.relpath(SKILL_DIR, demo_dir)).as_posix()
        return f'HERE / "{rel}"'
    return f'"{SKILL_DIR}"'


def render(demo_dir: Path, *, terminal: bool, url: str | None) -> str:
    story = "<one line: the story this demo tells>"
    header = HEADER.format(
        story=story,
        skill_dir=skill_dir_expression(demo_dir),
        recorder="TerminalRecorder" if terminal else "Recorder",
    )
    if terminal:
        return header + TERMINAL_BODY
    return header + WEB_BODY.format(url=f', base_url="{url}"' if url else "")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="demo-new",
        description="Write a ready-to-run record.py into a new demo folder.",
    )
    parser.add_argument("demo_dir", type=Path, help="the demo folder to create")
    parser.add_argument(
        "--terminal",
        action="store_true",
        help="record a CLI or TUI instead of a web app",
    )
    parser.add_argument(
        "--url",
        help="the app's base URL (web only; default: DEMO_VIDEO_BASE_URL)",
    )
    args = parser.parse_args()
    if args.terminal and args.url:
        parser.error("--url is for web demos; a terminal demo has no base URL")

    demo_dir = args.demo_dir.expanduser().resolve()
    record = demo_dir / "record.py"
    if record.exists():
        print(f"demo-new: {record} already exists - nothing written", file=sys.stderr)
        return 1
    demo_dir.mkdir(parents=True, exist_ok=True)
    record.write_text(render(demo_dir, terminal=args.terminal, url=args.url))
    record.chmod(0o755)
    print(f"wrote {record}")
    print(f"next: edit it, then  {SKILL_DIR}/scripts/demo-rehearse {record}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

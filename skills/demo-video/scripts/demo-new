#!/usr/bin/env -S uv run --script
# vim: set ft=python:
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
"""Start a demo: write a record.py that already runs into a new folder.

    <skill-dir>/scripts/demo-new <demo-dir> [--url URL | --terminal]

Run the result with `uv run <demo-dir>/record.py`. Refuses to overwrite.
"""

import argparse
import os
import sys
from pathlib import Path

SKILL = Path(__file__).resolve().parent.parent

WEB = """\
    with Recorder(HERE, base_url="{url}") as rec:
        rec.goto("/")
        rec.caption("Say what the viewer is looking at.")
        rec.hold()
"""
TERMINAL = """\
    with TerminalRecorder(HERE) as rec:
        rec.caption("Say what this command does.")
        rec.run("echo hello")
        rec.hold()
"""
TEMPLATE = """\
#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["playwright"]
# ///
\"\"\"Demo: <what this shows, in one line>.\"\"\"

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKILL = Path(os.environ.get("DEMO_VIDEO_SKILL_DIR") or {skill})
sys.path.insert(0, str(SKILL / "helpers"))
from demo_recording import {cls}  # noqa: E402

{body}"""


def skill_expr(demo: Path) -> str:
    """Relative to the storyboard when both live in one git repo, so a clone works."""
    here = demo.resolve()
    for parent in [here, *here.parents]:
        if (parent / ".git").exists():
            if SKILL.is_relative_to(parent):
                rel = Path(os.path.relpath(SKILL, here))
                return f'HERE / "{rel.as_posix()}"'
            break
    return f'"{SKILL}"'


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("dir", type=Path)
    parser.add_argument("--url", default="http://localhost:3000")
    parser.add_argument("--terminal", action="store_true")
    args = parser.parse_args()
    target = args.dir / "record.py"
    if target.exists():
        print(f"demo-new: {target} already exists", file=sys.stderr)
        return 1
    args.dir.mkdir(parents=True, exist_ok=True)
    body = TERMINAL if args.terminal else WEB.format(url=args.url)
    cls = "TerminalRecorder" if args.terminal else "Recorder"
    # The `with` block sits at module level; strip the template's indent.
    body = "\n".join(line[4:] for line in body.splitlines()) + "\n"
    target.write_text(TEMPLATE.format(skill=skill_expr(args.dir), cls=cls, body=body))
    print(f"demo-new: wrote {target}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

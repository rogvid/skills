        "web/index.html",
        'placeholder="Title, requester, or ticket id"',
        'placeholder="Title or ticket id"',
        ["QueuePage.test_the_placeholder_no_longer_says_title_or_ticket_id"],
    ),
    (
        "the fixture stores every address in lower case, so the fold grades nothing",
        "data/tickets.json",
        '"requester": "Mira.Haas@northwind.example",',
        '"requester": "mira.haas@northwind.example",',
        ["QueuePage.test_at_least_one_seeded_address_is_not_already_lower_case"],
    ),
    (
        "the fixture puts the search term in a title, hollowing out the control",
        "data/tickets.json",
        '"title": "Cannot remove a seat from the team page",',
        '"title": "Cannot remove mira from the team page",',
        ["QueuePage.test_the_search_term_appears_in_no_title_and_no_id"],
    ),
]


def fault_inject() -> int:
    """Break one thing at a time and require the named tests to notice."""
    failures = 0
    for name, rel, old, new, must_fail in INJECTIONS:
        with tempfile.TemporaryDirectory() as tmp:
            app = Path(tmp) / "ticket-queue"
            shutil.copytree(ROOT, app, ignore=shutil.ignore_patterns("demos"))
            target = app / rel
            text = target.read_text(encoding="utf-8")
            hits = text.count(old)
            if hits != 1:
                print(
                    f"ABORT: injection {name!r} matched {hits} times in {rel}, "
                    f"expected exactly 1. The injection did not land, so "
                    f"nothing it would have proven is proven.",
                    file=sys.stderr,
                )
                print(f"       looked for: {old!r}", file=sys.stderr)
                return 3
            target.write_text(text.replace(old, new), encoding="utf-8")

            done = subprocess.run(
                [sys.executable, str(Path(__file__).resolve()), "--_inner"],
                capture_output=True,
                text=True,
                env={**os.environ, "TICKET_QUEUE_ROOT": str(app)},
            )
            noticed = {t for t in must_fail if t in done.stderr}
            missed = set(must_fail) - noticed
            ok = done.returncode != 0 and not missed
            print(f"{'PASS' if ok else 'FAIL'}  break: {name}")
            print(f"      in {rel}: {old.strip().splitlines()[0][:66]}…")
            if ok:
                for line in [
                    ln
                    for ln in done.stderr.splitlines()
                    if ln.startswith(("FAIL:", "ERROR:"))
                ][:4]:
                    print(f"      {line}")
            else:
                failures += 1
                if missed:
                    print(f"      these tests did NOT fail: {sorted(missed)}")
                if done.returncode == 0:
                    print("      the suite passed against broken code")
                print(textwrap.indent(done.stderr[-1500:], "      | "))
            print()
    if failures:
        print(
            f"{failures} injection(s) went unnoticed — those assertions grade nothing."
        )
        return 1
    print(f"All {len(INJECTIONS)} injections were caught.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--fault-inject",
        action="store_true",
        help="break each thing an assertion watches and require it to notice",
    )
    parser.add_argument("--_inner", action="store_true", help=argparse.SUPPRESS)
    args, rest = parser.parse_known_args()
    if args.fault_inject:
        return fault_inject()
    result = unittest.main(argv=[sys.argv[0], *rest], exit=False, verbosity=1)
    return 0 if result.result.wasSuccessful() else 1


if __name__ == "__main__":
    raise SystemExit(main())


# ---------------------------------------------------------------------------
# What this suite does NOT cover
# ---------------------------------------------------------------------------
#
# - **The CLI.** `tickets list --status` is untouched by #129 and #132 and has
#   no search; nothing here runs it.
# - **The detail panel, the assign modal and the copy button.** They are on the
#   page the suite loads but no assertion reads them.
# - **How the queue looks.** `test_the_requester_is_legible_on_the_matching_row`
#   asks only whether the requester occupies a box a person could read; it does
#   not grade contrast, truncation or layout at other viewport sizes. The demo
#   video is where that is reviewed, by a human.
# - **Searching the ticket body, and highlighting the matched substring.** Both
#   are out of scope in #129 and stay out.

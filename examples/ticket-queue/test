# must fail). The driver aborts unless the exact string matches once.

INJECTIONS = [
    (
        "the search stops comparing the requester (the bug in #132)",
        "web/app.js",
        "        t.requester.toLowerCase().includes(term))",
        "        false)",
        [
            "QueuePage.test_a_requester_name_finds_the_ticket_whose_title_lacks_it",
            "QueuePage.test_part_of_an_address_finds_that_persons_tickets",
            "QueuePage.test_a_shared_address_domain_finds_everyone_on_it",
        ],
    ),
    (
        "the row stops rendering the requester, so a match has nothing to show",
        "web/app.js",
        '            <span class="ticket-requester">${t.requester}</span>\n',
        "",
        [
            "QueuePage.test_the_requester_is_legible_on_the_matching_row",
            "QueuePage.test_every_listed_row_shows_its_own_requester",
        ],
    ),
    (
        "the requester is rendered but not legible on screen",
        "web/styles.css",
        ".ticket-requester {\n  color: var(--muted);",
        ".ticket-requester {\n  display: none;\n  color: var(--muted);",
        ["QueuePage.test_the_requester_is_legible_on_the_matching_row"],
    ),
    (
        "every row renders the same person's address",
        "web/app.js",
        '<span class="ticket-requester">${t.requester}</span>',
        '<span class="ticket-requester">${tickets[0].requester}</span>',
        ["QueuePage.test_every_listed_row_shows_its_own_requester"],
    ),
    (
        "the search stops folding the typed term",
        "web/app.js",
        "  const term = searchTerm.trim().toLowerCase();",
        "  const term = searchTerm.trim();",
        ["QueuePage.test_search_folds_case_in_both_directions"],
    ),
    (
        "the search stops folding the title it compares against",
        "web/app.js",
        "        t.title.toLowerCase().includes(term) ||",
        "        t.title.includes(term) ||",
        ["QueuePage.test_search_folds_case_in_both_directions"],
    ),
    (
        "the search stops folding the requester it compares against",
        "web/app.js",
        "        t.requester.toLowerCase().includes(term))",
        "        t.requester.includes(term))",

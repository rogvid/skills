            problems, video_rect, still_rect, size = record_web(out_dir, base_url)
        except Exception as exc:  # noqa: BLE001 - a raising take is a failure
            return [f"web: Recorder raised {type(exc).__name__}: {exc}"]
    return (
        problems
        + check_take(
            "web",
            out_dir,
            WEB_SHOTS,
            WEB_DURATION_S,

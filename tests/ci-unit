def stage_tree(tmp: Path) -> dict[str, Path]:
    """Copy everything an injection may break into `tmp`, and name the copies.

    Split out of `fault_inject` so `check_anchors` resolves targets through the
    identical staging rather than a second implementation of it.
    """
    root = tmp / "scripts"
    shutil.copytree(SCRIPTS, root)
    # The skill travels too: the target guard is bundled with it now,
    # and both the module under `helpers/` and the CLI under `scripts/`
    # have to be the broken copy or the inner run grades the tree.
    skill = tmp / "demo-video"
    shutil.copytree(SKILL, skill)
    # And the workflow, because the two gates agreeing is a property
    # of that file and of nothing else.
    workflow = tmp / "demo-video.yml"
    shutil.copy(WORKFLOW, workflow)
    # And the caller, because the two agreeing on permissions is a property of
    # the *pair* — a called workflow cannot request more than its caller
    # grants, and neither file alone shows the mismatch.
    caller = tmp / "ticket-queue-demo.yml"
    shutil.copy(CALLER, caller)
    # And this file, so an injection can reach the suite's own
    # allowlist. The copy is what runs; it reads every path it uses
    # from the three variables below, so `REPO` resolving to /tmp
    # changes nothing.
    inner = tmp / "ci-unit"
    shutil.copy(Path(__file__).resolve(), inner)
    return {
        "root": root,
        "skill": skill,
        "workflow": workflow,
        "caller": caller,
        "inner": inner,
    }


def injection_target(script: str, staged: dict[str, Path]) -> Path:
    """Which staged file an injection's `script` field names."""
    if script == "target.py":
        return staged["skill"] / "helpers" / "demo_recording" / script
    if script.startswith(("scripts/", "helpers/")):
        # Anything shipped with the skill rather than under
        # `.github/scripts/`: the three CLIs, and the package modules
        # they import. `GuardExitCode` runs `demo-target-guard`;
        # `grade` and `shots` at the top of this file import the other
        # two, which is how an injection into either reddens the
        # couplings the comment has with them and cannot import. A
        # prefix rather than a list because the list was a second
        # place to remember, and `demo_recording/links.py` (#373) is
        # the first module either CLI's behaviour lives in.
        return staged["skill"] / script
    if script == "demo-video.yml":
        return staged["workflow"]
    if script == "ticket-queue-demo.yml":
        return staged["caller"]
    if script == "tests/ci-unit":
        return staged["inner"]
    return staged["root"] / script


def check_anchors() -> int:
    """Every injection still resolves: its pattern matches once, its tests exist.

    The cheap half of `--fault-inject`; see `tests/unit`'s twin for why the
    weaker question is worth its own mode. One staging, no inner runs.
    """
    stale: list[str] = []
    with tempfile.TemporaryDirectory() as tmp:
        staged = stage_tree(Path(tmp))
        known: set[str] = set()
        tree = ast.parse(staged["inner"].read_text(encoding="utf-8"))
        for cls in tree.body:
            if isinstance(cls, ast.ClassDef):
                known |= {
                    f"{cls.name}.{fn.name}"
                    for fn in cls.body
                    if isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef))
                }
        for name, script, old, _new, must_fail in INJECTIONS:
            target = injection_target(script, staged)
            hits = target.read_text(encoding="utf-8").count(old)
            if hits != 1:
                stale.append(
                    f"{name!r} matched {hits} times in {script}, expected "
                    f"exactly 1 — the injection would not land, so nothing "
                    f"it claims to prove is proven.\n       looked for: {old!r}"
                )
            gone = [t for t in must_fail if t not in known]
            if gone:
                stale.append(
                    f"{name!r} names {', '.join(gone)}, which this suite does "
                    f"not define — nothing it claims to prove is proven."
                )
    if stale:
        print(
            f"ABORT: {len(stale)} of {len(INJECTIONS)} injections no longer resolve.",
            file=sys.stderr,
        )
        for line in stale:
            print(f"  - {line}", file=sys.stderr)
        return 3
    print(f"All {len(INJECTIONS)} injections still resolve.")
    return 0


class CallerPermissions(unittest.TestCase):
    """The caller must grant at least what the reusable workflow declares.

    A called workflow cannot request more permission than its caller grants,
    and the failure mode is unusually bad: the run is refused **before it
    starts**, as `startup_failure`, with no job and no log to read. Nothing
    points at the caller, and `actionlint` does not check across the two files.

    That is how #410's `contents: write` was found — by a run that produced
    nothing at all, on a change that had passed every local check.
    """

    RANK = {"none": 0, "read": 1, "write": 2}

    def perms(self, path: Path) -> dict:
        """The job-level `permissions:` map, read without a YAML parser.

        `tests/ci-unit` ships `dependencies = []` and the repo keeps it that
        way, so this reads the block by indentation: `    permissions:` at job
        level, then every `      scope: level` line under it, comments and
        blank lines skipped. Both files are written that way and `actionlint`
        already refuses malformed YAML, so the narrow reader is enough.
        """
        found: dict[str, str] = {}
        inside = False
        for line in path.read_text(encoding="utf-8").splitlines():
            if re.match(r"^ {4}permissions:\s*$", line):
                inside = True
                continue
            if not inside:
                continue
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            m = re.match(r"^ {6}([a-z-]+):\s*([a-z]+)\s*$", line)
            if not m:
                break
            found[m.group(1)] = m.group(2)
        return found

    def test_the_caller_grants_at_least_what_the_workflow_declares(self):
        callee = self.perms(_WORKFLOW)
        caller = self.perms(_CALLER)
        # The haystack, before anything is claimed over it: a file whose
        # permissions this could not read would make every comparison below
        # true over an empty dict.
        self.assertTrue(callee, f"no permissions block found in {_WORKFLOW}")
        self.assertTrue(caller, f"no permissions block found in {_CALLER}")
        short = {
            scope: (caller.get(scope, "none"), need)
            for scope, need in callee.items()
            if self.RANK.get(caller.get(scope, "none"), 0) < self.RANK.get(need, 0)
        }
        self.assertEqual(
            short,
            {},
            f"{_CALLER.name} grants less than {_WORKFLOW.name} declares for "
            f"{sorted(short)} — GitHub refuses such a run before it starts, as "
            f"`startup_failure`, with no log to read",
        )

    def test_the_workflow_can_write_contents_for_the_preview_upload(self):
        """Named out loud, so dropping it back to `read` has to delete a line
        that says why it is not `read`. The preview is uploaded as a release
        asset, which is a write even though no ref moves (#410)."""
        self.assertEqual(self.perms(_WORKFLOW).get("contents"), "write")


class BlockDemoChoice(unittest.TestCase):
    """Which demo the pull-request block describes, when a run recorded several.

    A change under an app root makes every storyboard of that app stale. The
    first live run of this pipeline recorded **seven**, and taking the first
    directory took the alphabetically first — a demo with no acceptance
    criteria — so the block rendered an empty checklist for a pull request with
    four clauses to tick, and the demo that had them went unmentioned.
    """

    def tree(self, spec: dict[str, int | None]):
        """A staging root of demos, each with `n` declared criteria (None = no
        readable timeline)."""
        tmp = tempfile.TemporaryDirectory()
        self.addCleanup(tmp.cleanup)
        root = Path(tmp.name)
        for name, count in spec.items():
            (root / name).mkdir(parents=True)
            if count is None:
                continue
            doc = {"coverage": {"criteria": {f"AC-{i}": "x" for i in range(count)}}}
            (root / name / "timeline.json").write_text(json.dumps(doc))
        return root

    def test_the_demo_with_the_most_clauses_wins(self):
        root = self.tree({"a-empty": 0, "z-rich": 4})
        self.assertEqual(pr_body.pick_demo(["a-empty", "z-rich"], root), "z-rich")

    def test_a_storyboard_this_branch_touched_beats_a_richer_untouched_one(self):
        """The second live run's defect. Two demos tied at four clauses, the tie
        went to the earlier name, and the block paired *this* change's video
        with *another* demo's checklist — a reviewer would have ticked search
        criteria while watching an assign video."""
        root = self.tree({"old-rich": 4, "new-mine": 4})
        picked = pr_body.pick_demo(
            ["old-rich", "new-mine"], root, ["new-mine/record.py"]
        )
        self.assertEqual(picked, "new-mine")

    def test_a_touched_demo_wins_even_with_fewer_clauses(self):
        """The branch's own work is the stronger signal: a pull request is
        about the storyboard it changed, whatever anything else declares."""
        root = self.tree({"old-rich": 9, "new-mine": 1})
        picked = pr_body.pick_demo(
            ["old-rich", "new-mine"], root, ["new-mine/images/01.png"]
        )
        self.assertEqual(picked, "new-mine")

    def test_changed_paths_are_re_rooted_before_they_are_compared(self):
        """`git diff` gives repository-relative paths; demo names are relative
        to working-directory. Comparing them unrooted matches nothing —
        silently — so the rule never fires and the tie-break decides
        everything, which is the bug still present and now invisible."""
        root = self.tree({"old-rich": 4, "new-mine": 4})
        changed = ["examples/ticket-queue/new-mine/record.py"]
        self.assertEqual(
            pr_body.pick_demo(
                ["old-rich", "new-mine"], root, changed, "examples/ticket-queue"
            ),
            "new-mine",
        )

    def test_a_path_outside_the_prefix_touches_nothing(self):
        """The control on re-rooting: a change to another app's identically
        named demo must not claim this one."""
        root = self.tree({"old-rich": 4, "new-mine": 4})
        changed = ["examples/other-app/new-mine/record.py"]
        self.assertEqual(
            pr_body.pick_demo(
                ["old-rich", "new-mine"], root, changed, "examples/ticket-queue"
            ),
            "old-rich",
        )

    def test_it_is_not_simply_the_first(self):
        """The regression this was written for, stated as its own assertion so
        an edit back to `demos[0]` has to delete a line that says why."""
        root = self.tree({"a-empty": 0, "b-rich": 3})
        self.assertNotEqual(pr_body.pick_demo(["a-empty", "b-rich"], root), "a-empty")

    def test_a_tie_takes_the_earlier_name_so_the_choice_is_stable(self):
        root = self.tree({"a-one": 2, "b-two": 2})
        self.assertEqual(pr_body.pick_demo(["a-one", "b-two"], root), "a-one")
        self.assertEqual(pr_body.pick_demo(["b-two", "a-one"], root), "b-two")

    def test_an_unreadable_timeline_counts_as_zero_rather_than_raising(self):
        """A block describing the wrong demo is a bad block; no block at all is
        worse, and this step runs after a take that already succeeded."""
        root = self.tree({"broken": None, "good": 1})
        self.assertEqual(pr_body.pick_demo(["broken", "good"], root), "good")

    def test_one_demo_is_chosen_even_with_no_criteria_at_all(self):
        root = self.tree({"only": 0})
        self.assertEqual(pr_body.pick_demo(["only"], root), "only")

    def test_no_demos_gives_no_demo(self):
        self.assertEqual(pr_body.pick_demo([], None), "")



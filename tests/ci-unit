        self.assertEqual(
            guard.scan('x = ("http://127.0.0.1:80")'), ["http://127.0.0.1:80"]
        )


class GuardExitCode(unittest.TestCase):
    """The workflow only sees the exit status, so assert on that."""

    def _run(self, *args: str) -> subprocess.CompletedProcess:
        return subprocess.run(
            [sys.executable, str(GUARD_CLI), *args],
            capture_output=True,
            text=True,
        )

    def test_loopback_exits_zero(self):
        self.assertEqual(self._run("--url", "http://127.0.0.1:8901").returncode, 0)

    def test_public_exits_two_and_says_why_on_stderr(self):
        done = self._run("--url", "https://tickets.acme.com", "--allow-private")
        self.assertEqual(done.returncode, 2)
        self.assertIn("tickets.acme.com", done.stderr)

    def test_a_numeric_host_exits_two_even_with_the_private_opt_in(self):
        # `--allow-private` is what a workflow passes for a container service
        # name, and it is the configuration this host reached exit 0 under.
        done = self._run("--url", "http://3639549472/", "--allow-private")
        self.assertEqual(done.returncode, 2)
        self.assertIn("3639549472", done.stderr)

    def test_checking_nothing_is_not_reported_as_checking_everything(self):
        # A step that passes an unset variable. Exit 0 is deliberate — a
        # terminal storyboard has no URL — but the line must not claim a
        # property of the empty set it never looked at.
        done = self._run("--url", "")
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn("all loopback", done.stdout)
        self.assertIn("0 URL(s) checked", done.stdout)

    def test_require_refuses_when_nothing_reached_the_classifier(self):
        done = self._run("--url", "", "--require")
        self.assertEqual(done.returncode, 2)
        self.assertIn("no URL reached the classifier", done.stderr)
        # And it is about the count, not about --require itself: a run that
        # did check something is unaffected by the flag.
        checked = self._run("--url", "http://127.0.0.1:8901", "--require")
        self.assertEqual(checked.returncode, 0, checked.stderr)


# --------------------------------------------------------------------------
# The pre-check and the recorder are handed the same facts
# --------------------------------------------------------------------------
#
# Two gates classify the recording target on one run: the `Refuse a target
# that could be production` step, before anything is installed, and the
# recorder itself, in `__init__`. They apply the *same* rules — `target.py`,
# through two doors — so the only way they can disagree is by being handed
# different facts.
#
# That is exactly how they disagreed. The guard step read
# `allow-private-network-target` and the Record step did not pass it on, so a
# caller who set it passed the pre-check and then raised `TargetRefused` at
# construction — several minutes, one browser and one Chromium download later,
# on the ordinary configured path. Nothing saw it: no test in this repository
# read the workflow file, and no in-repo caller sets that input, so CI was
# green and would have stayed green.
#
# What is graded below is the *coupling*, not the YAML. Step ordering, `if:`
# conditions and whether a step runs at all are still GitHub's to execute and
# actionlint's to type-check. This asks one question a text can answer: does
# every fact the guard classifies on reach the recorder that will re-classify
# it, from the same input.

# What the guard step names each fact -> what the recorder reads it as. Both
# recorders resolve their target through `DEMO_VIDEO_*` (`core.py`'s `_env`
# and `_env_flag`, applied in `target.py`), so these are the names the Record
# step has to export for the two verdicts to agree.
GUARD_FACT_TO_RECORDER_ENV = {
    "BASE_URL": "DEMO_VIDEO_BASE_URL",
    "ALLOW_PRIVATE": "DEMO_VIDEO_ALLOW_PRIVATE",
}

# A fact the guard reads that the Record step deliberately does not export
# under a `DEMO_VIDEO_*` name, with the reason. An allowlist without reasons is
# how a check like this stops grading anything, so the reasons are asserted.
GUARD_FACT_NOT_PASSED = {
    "EXTRA_ENV": (
        "not a recorder setting: the 'Export the caller's extra environment' "
        "step writes each KEY=VALUE line to $GITHUB_ENV, so the storyboard "
        "sees them under the caller's own names"
    ),
}

GUARD_STEP = "Refuse a target that could be production"
RECORD_STEP = "Record"
_INPUT_RE = re.compile(r"^\$\{\{\s*inputs\.([a-z0-9-]+)\s*\}\}$")


def workflow_steps(text: str) -> dict[str, list[str]]:
    """Step name -> the lines under it. Unnamed steps (`- uses:`) are skipped."""
    steps: dict[str, list[str]] = {}
    current: str | None = None
    for line in text.splitlines():
        if line.startswith("      - "):
            head = line[len("      - ") :]
            current = (
                head[len("name: ") :].strip() if head.startswith("name: ") else None
            )
            if current is not None:
                steps[current] = []
            continue
        if current is not None:
            steps[current].append(line)
    return steps


def step_env(lines: list[str]) -> dict[str, str]:
    """One step's `env:` mapping, as written.

    Comments are skipped, and that is not tidiness: a `#` line holding a colon
    parses as an entry, and this file has one — the note above
    `DEMO_VIDEO_ALLOW_PRIVATE` quotes the input name. It produced a phantom
    `'# same question'` key, harmless to the lookups below but a free unit of
    margin for the `len(self.record)` control, which is exactly how a control
    stops controlling anything.
    """
    out: dict[str, str] = {}
    inside = False
    for line in lines:
        if line == "        env:":
            inside = True
            continue
        if inside:
            if not line.startswith("          "):
                break
            entry = line.strip()
            if entry.startswith("#"):
                continue
            key, sep, value = entry.partition(":")
            if sep:
                out[key.strip()] = value.strip()
    return out


class WorkflowGates(unittest.TestCase):
    """Whatever the guard step is permitted, the Record step passes through.

    **A known false positive, so nobody debugs a correct workflow.** This reads
    the two steps' own `env:` blocks. Hoisting `DEMO_VIDEO_ALLOW_PRIVATE` to
    the job-level `env:` is a perfectly good workflow and this will call it
    missing, with a message saying the export is not there. Wrong in the
    conservative direction — it fails a working configuration rather than
    passing a broken one — but wrong. If you hoisted it deliberately, teach
    `step_env` about the job block rather than deleting the assertion.
    """

    def setUp(self):
        text = _WORKFLOW.read_text(encoding="utf-8")
        self.steps = workflow_steps(text)
        # The haystack, before anything is claimed about it. A parser that
        # stopped matching would make every assertion below hold over an empty
        # mapping — the catalogue's vacuous sweep, and the likeliest way this
        # check dies quietly when the workflow is reindented or renamed.
        for name in (GUARD_STEP, RECORD_STEP):
            self.assertIn(name, self.steps, f"no {name!r} step in {_WORKFLOW}")
        self.guard = step_env(self.steps[GUARD_STEP])
        self.record = step_env(self.steps[RECORD_STEP])
        self.assertGreaterEqual(len(self.guard), 3, self.guard)
        self.assertGreaterEqual(len(self.record), 2, self.record)

    def facts(self) -> dict[str, str]:
        """Guard env entries that come from a workflow input -> that input."""
        found = {}
        for key, value in self.guard.items():
            if match := _INPUT_RE.match(value):
                found[key] = match.group(1)
        return found

    def test_the_guard_classifies_on_more_than_one_input(self):
        # The control on `facts()`. Everything below is "each fact is
        # accounted for", which is free to satisfy over none of them.
        self.assertGreaterEqual(len(self.facts()), 2, self.facts())

    def test_every_entry_that_mentions_an_input_is_read_as_one(self):
        # `facts()` is anchored, so a fact can leave it *without leaving the
        # file* — YAML-quote the value, or write
        # `${{ inputs.x && 'true' || 'false' }}`, and the entry is still there,
        # still fed to the guard, and no longer counted. Reproduced with the
        # Record step's export deleted at the same time: the suite stayed
        # green, which is the original regression reachable again through a
        # cosmetic edit.
        #
        # The counting controls cannot see it — quoting changes no key, and
        # `len(facts()) >= 2` sits one under the current three. So the claim
        # here is equality, not a floor: an entry this file recognises as
        # mentioning an input must be one `facts()` reads. A form that is not
        # supported fails loudly instead of silently dropping out.
        mentioned = {k for k, v in self.guard.items() if "inputs." in v}
        self.assertEqual(
            set(self.facts()),
            mentioned,
            f"the guard step mentions {sorted(mentioned)} but only "
            f"{sorted(self.facts())} parse as an input. An entry that dropped "
            f"out is a fact nothing below checks the passthrough of.",
        )

    def test_every_fact_the_guard_classifies_on_reaches_the_recorder(self):
        wrong = []
        for fact, workflow_input in sorted(self.facts().items()):
            if fact in GUARD_FACT_NOT_PASSED:
                continue
            recorder_env = GUARD_FACT_TO_RECORDER_ENV.get(fact)
            if recorder_env is None:
                wrong.append(
                    f"{fact} (from inputs.{workflow_input}) is neither mapped "
                    f"to a DEMO_VIDEO_* name nor listed as deliberately not "
                    f"passed through"
                )
                continue
            exported = self.record.get(recorder_env)
            if exported is None:
                wrong.append(
                    f"the guard permits on inputs.{workflow_input} but the "
                    f"Record step exports no {recorder_env}, so the recorder "
                    f"re-classifies without it and can refuse what the "
                    f"pre-check passed"
                )
            elif (match := _INPUT_RE.match(exported)) is None:
                wrong.append(
                    f"{recorder_env} is {exported!r}, not read from an input — "
                    f"the two gates can no longer be given the same answer"
                )
            elif match.group(1) != workflow_input:
                wrong.append(
                    f"the guard reads inputs.{workflow_input} and the Record "
                    f"step exports {recorder_env} from inputs.{match.group(1)}"
                )
        self.assertEqual(wrong, [], "\n  - ".join([""] + wrong))

    def test_the_private_opt_in_is_declared_a_boolean_input(self):
        # This is what grounds `tests/unit`'s
        # `test_the_spelling_a_boolean_workflow_input_renders_is_accepted`. A
        # `type: boolean` input renders into the step's environment as the
        # string `true` or `false` — never `1` — and that pair is what the
        # recorder's `_env_flag` has to accept for the two gates to agree.
        # Change the type and a different set of strings arrives.
        text = _WORKFLOW.read_text(encoding="utf-8")
        block = re.search(
            r"\n      allow-private-network-target:\n(.*?)(?=\n      \S)",
            text,
            re.DOTALL,
        )
        self.assertIsNotNone(block, "no allow-private-network-target input declared")

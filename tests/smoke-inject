        name="the criterion beat does not record which clause it showed",
        module="core.py",
        old='        with self._beat("criterion", selector=key, caption=text, ',
        new='        with self._beat("criterion", selector=None, caption=text, ',
        arm="--coverage-only",
        sites=("check_coverage",),
        must_contain=("the beat log does not say which clause was on screen",),
    ),
    Injection(
        # The control for the four above: with no card in the take at all,
        # every one of their assertions has nothing to grade, and a check that
        # quietly skipped an absent card would report this arm green.
        name="the coverage fixture stops raising a criterion card",
        module="tests/smoke",
        old="        rec.criterion(COVERAGE_CARD)",
        new="        pass",
        arm="--coverage-only",
        sites=("check_coverage",),
        must_contain=("nothing about the card",),
    ),
    Injection(
        # The arm that a weaker assertion slept through: "AC-3 in timeline.md"

        old='        "index": beat.get("index"),',
        new='        "index": (beat.get("index") or 0) + 1,',
        arm="--coverage-only",
        sites=("check_coverage", "check_coverage_merge"),
        must_contain=(
            "a reviewer scrubbing to that timestamp would land",
            "expected [5] — the merged",
        ),
    ),
    Injection(
        # Issue #137: the field is in the fixture, in the output, and pinned by
        # nothing. `check_coverage_merge` now asserts it; this is what keeps it
        # asserted.
        name="a claimed beat forgets which segment it came from",
        module="coverage.py",
        # Stale for the same reason as the entry above — #309's `_claim_row`
        # extraction. This one was hidden behind it: `--self-test` reports the
        # first STALE entry it meets, so fixing one uncovers the next.
        old='        "segment": beat.get("segment"),',
        new='        "segment": None,',
        arm="--coverage-only",
        sites=("check_coverage_merge",),
        must_contain=("a reviewer handed a bare 'beat 5'",),
    ),
    Injection(
        name="a tag naming an undeclared criterion is accepted at the call",
        module="core.py",
        old="        unknown = [key for key in ids if key not in self._criteria]",
        new="        unknown = []",
        arm="--coverage-only",
        sites=("check_coverage_refusals",),
        must_contain=("a tag naming an undeclared criterion", " was accepted"),
    ),
    # -- the ticket's own sentence, on screen (issue #280) --------------------
    #
    # Five entries, and the split matters: four break the *recorder* and are
    # caught by assertions reading `timeline.json`, one breaks the drawing and
    # is caught only by the assertion that reads the page. Without that last
    # one every claim about this card would be the beat log agreeing with the
    # values it was written from.
    Injection(
        # The failure the verb exists to make impossible, in the only form it
        # can still take: a card that puts *something* on screen which is not
        # the declared clause. Nothing else in the take notices — `timeline.md`

        name="the card shows the criterion's id instead of its declared sentence",
        module="core.py",
        old="        text = self._criteria[key]",
        new="        text = key",
        arm="--coverage-only",
        sites=("check_coverage",),
        must_contain=(
            "The card reads the criteria map so that a second wording",
            "the screen the recorder was driving never showed those words",
        ),
    ),
    Injection(
        # The beat log perfect and the browser untouched. This is the entry
        # that makes the page-snapshot assertion worth having: every other
        # claim about the card still passes here, because every other claim is
        # read out of values the recorder wrote down rather than drew.
        name="the card is logged in full and never drawn on the page",
        module="core.py",
        old='            self.page.evaluate("t => window.__demoInterlude(t)", text)',
        new="            pass",
        arm="--coverage-only",
        sites=("check_coverage",),
        must_contain=("the screen the recorder was driving never showed those words",),
    ),
    Injection(
        name="the card claims nothing, so coverage never lists the clause it showed",
        module="core.py",
        old='        with self._beat("criterion", selector=key, caption=text, '
        "**_ac_field([key])):",
        new='        with self._beat("criterion", selector=key, caption=text):',
        arm="--coverage-only",
        sites=("check_coverage",),
        must_contain=(

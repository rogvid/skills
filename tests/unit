# The two verb sets, from the other end (issue #165).
#
# `tests/smoke`'s `check_verb_classification` computes `declared - classified`
# and fires when a verb the recorders log is in neither set. It is structurally
# blind to the opposite residue — a *member* no recorder logs — and its summary
# line intersects each set with `declared` before counting, so the number it
# prints does not move either. `"bridge"` sat in `CONTENT_PASSIVE_VERBS` under
# that blind spot until #165, and the shipped table in `reference/timeline.md`
# was copied out of it.
#
# The scrape below is hand-written rather than imported from `tests/smoke`,
# and deliberately anchored rather than broad: over-matching would invent
# verbs, and an invented verb is exactly what would let a dead member hide
# again. Under-matching cannot hide anything — it fails loudly, naming the
# members it could not account for.
_VERB_PATTERNS = (
    re.compile(r'@_beat_verb\(\s*"([a-z_]+)"'),
    re.compile(r'self\._beat\(\s*"([a-z_]+)"'),
)

# Below this many names in the two sets together, "every member is logged"
# holds over almost nothing — the catalogue's vacuous sweep. It is 21 today.
CONTENT_VERB_FLOOR = 15


def logged_verbs() -> set[str]:
    """Every verb name some recorder records a beat under."""
    found: set[str] = set()
    for path in (_PKG_PARENT / "demo_recording").glob("*.py"):
        source = path.read_text(encoding="utf-8")
        for pattern in _VERB_PATTERNS:
            found |= set(pattern.findall(source))
    return found


class VerbClassification(unittest.TestCase):
    def test_every_classified_verb_is_one_a_recorder_actually_logs(self):
        classified = CONTENT_ACTING_VERBS | CONTENT_PASSIVE_VERBS
        # The haystack, before anything is claimed about it: an empty pair of
        # sets satisfies "every member is logged" trivially.
        self.assertGreaterEqual(
            len(classified),
            CONTENT_VERB_FLOOR,
            f"only {len(classified)} verbs are classified — 'every member is "
            f"logged' would hold over almost nothing",
        )
        logged = logged_verbs()
        self.assertGreaterEqual(
            len(logged),
            CONTENT_VERB_FLOOR,
            f"only {len(logged)} verbs were scraped out of the package "
            f"({sorted(logged)}) — the scrape is broken, not the sets",
        )
        dead = sorted(classified - logged)
        self.assertEqual(
            dead,
            [],
            f"{dead} are classified acting or passive and no recorder logs "
            f"any of them. A name sitting beside live ones reads as though it "
            f"still classifies something, and the documentation copies it out "
            f"(#165). Delete it, or say beside it which beat log it accepts",
        )

    def test_no_verb_is_both_acting_and_passive(self):
        # The control for the sweep above: it is satisfied by a member that is
        # in both sets, and a verb classified both ways is a verb whose bucket
        # depends on which set is consulted first.
        self.assertEqual(sorted(CONTENT_ACTING_VERBS & CONTENT_PASSIVE_VERBS), [])



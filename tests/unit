class CoverageMd(unittest.TestCase):
    REPORT = {
        "criteria": {
            "AC-1": "Filterable.",
            "AC-2": "Explains itself.",
            "AC-3": "CLI agrees.",
        },
        "claimed": {
            "AC-1": [{"index": 1, "t_start": 3.2, "still": None, "segment": None}],
            "AC-2": [
                {"index": 2, "t_start": 5.4, "still": "images/02.png", "segment": None}
            ],
            "AC-3": [],
        },
        "unclaimed": ["AC-3"],
        "tagged_beats": 2,
        "untagged_beats": 4,
    }

    def test_the_unclaimed_sentence_names_every_unclaimed_id(self):
        text = "\n".join(_coverage_md(self.REPORT))
        self.assertIn("`AC-3`", text)
        self.assertIn("1 of 3 criteria have no beat claiming them", text)

    def test_the_section_says_claimed_and_never_says_demonstrated(self):
        # The whole honesty of issue #12. If this file said "demonstrated",
        # the conformance reviewer would be taking the storyboard author's
        # word for the exact thing it was convened to check.
        text = "\n".join(_coverage_md(self.REPORT)).lower()
        self.assertIn("claimed", text)
        self.assertNotIn("demonstrated", text)
        self.assertNotIn("proved", text.replace("not what it proved", ""))

    def test_a_take_with_no_criteria_renders_no_section_at_all(self):
        self.assertEqual(_coverage_md(None), [])
        self.assertEqual(_coverage_md({"criteria": {}}), [])

    def test_the_table_header_and_every_row_agree_on_column_count(self):
        rows = [
            ln
            for ln in _coverage_md(self.REPORT)
            if ln.startswith("|") and not ln.startswith("|---")
        ]
        self.assertGreater(len(rows), 3)  # header + one row per claim
        widths = {len(split_row(r)) for r in rows}
        self.assertEqual(widths, {4})


class TimelineMd(unittest.TestCase):
    def test_a_null_duration_is_not_rendered_as_a_number(self):
        # issue #20: a take that encoded no mp4 reports duration null, even
        # when a previous run's demo.mp4 is sitting right there. Rendering
        # that as 0.00s would restate the lie the null exists to avoid.
        text = render_timeline_md(envelope(duration=None, beats=[beat(0, "goto", 0.1)]))
        self.assertNotRegex(text, r"\b0\.00\s*s\b")

    def test_the_beat_table_survives_a_caption_holding_a_pipe(self):
        text = render_timeline_md(
            envelope(
                duration=3.0,
                beats=[beat(0, "caption", 0.1, caption="Filter | then sort")],
            )
        )
        rows = [
            ln
            for ln in text.splitlines()
            if ln.startswith("|") and not ln.startswith("|---")
        ]
        self.assertGreater(len(rows), 1)
        widths = {len(split_row(r)) for r in rows}
        self.assertEqual(len(widths), 1, f"ragged table: {widths}")



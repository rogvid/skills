class Coverage(unittest.TestCase):
    CRITERIA = {
        "AC-1": "The queue can be filtered to one status.",
        "AC-2": "A filter that matches nothing explains itself.",
        "AC-3": "The CLI prints the same filtered list.",
    }

    def test_a_criterion_no_beat_claims_is_reported_unclaimed(self):
        report = coverage_report(
            self.CRITERIA,
            [
                beat(1, "caption", 3.2, ac=["AC-1"]),
                beat(2, "shot", 5.4, ac=["AC-2"], still="images/02.png"),
            ],
        )
        self.assertEqual(report["unclaimed"], ["AC-3"])

    def test_every_declared_id_is_a_key_even_with_no_claims(self):
        # Stated invariant: a consumer iterating `claimed` sees the whole
        # ticket, not only its demonstrated half.
        report = coverage_report(self.CRITERIA, [beat(1, "caption", 3.2, ac=["AC-1"])])
        self.assertEqual(sorted(report["claimed"]), ["AC-1", "AC-2", "AC-3"])
        self.assertEqual(report["claimed"]["AC-3"], [])

    def test_a_claim_carries_the_beat_that_made_it(self):
        # Not "one claim was recorded" — which beat, at what time, with which
        # still. A count here would pass on a report that pointed a reviewer
        # at the wrong frame.
        report = coverage_report(
            self.CRITERIA,
            [
                beat(0, "goto", 0.1),
                beat(7, "shot", 5.46, ac=["AC-2"], still="images/02-empty.png"),
            ],
        )
        self.assertEqual(
            report["claimed"]["AC-2"],
            [
                {
                    "index": 7,
                    "segment": None,
                    "segment_index": 7,
                    "t_start": 5.46,
                    "still": "images/02-empty.png",
                }
            ],
        )

    def test_a_take_recorded_outside_a_ticket_has_no_report(self):
        # None, not {}. An empty report would read as a take that covered
        # nothing, which is a different and false statement.
        self.assertIsNone(coverage_report({}, [beat(1, "caption", 1.0)]))

    def test_one_beat_may_claim_several_criteria(self):
        report = coverage_report(
            self.CRITERIA, [beat(3, "shot", 4.0, ac=["AC-1", "AC-2"])]
        )
        self.assertEqual([c["index"] for c in report["claimed"]["AC-1"]], [3])
        self.assertEqual([c["index"] for c in report["claimed"]["AC-2"]], [3])
        self.assertEqual(report["tagged_beats"], 1)

    def test_tagged_and_untagged_beats_partition_the_log(self):
        beats = [
            beat(0, "goto", 0.1),
            beat(1, "caption", 1.0, ac=["AC-1"]),
            beat(2, "pause", 2.0),
            beat(3, "shot", 3.0, ac=["AC-2"]),
        ]
        report = coverage_report(self.CRITERIA, beats)
        self.assertEqual(report["tagged_beats"], 2)
        self.assertEqual(report["untagged_beats"], 2)
        self.assertEqual(report["tagged_beats"] + report["untagged_beats"], len(beats))


class CheckedCriteria(unittest.TestCase):
    def test_no_criteria_is_an_empty_map_not_an_error(self):
        self.assertEqual(_checked_criteria(None), {})

    def test_an_id_at_the_length_limit_is_accepted_and_one_over_is_not(self):
        # The boundary, not comfortably inside it: the catalogue's "ungraded
        # constant". The rule is 1-40 characters.
        ok = "A" + "b" * 39
        self.assertEqual(len(ok), 40)
        self.assertEqual(_checked_criteria({ok: "text"}), {ok: "text"})
        with self.assertRaises(ValueError):
            _checked_criteria({ok + "c": "text"})

    def test_an_id_holding_a_pipe_is_refused_before_it_reaches_a_table(self):
        with self.assertRaises(ValueError):
            _checked_criteria({"AC|1": "text"})

    def test_a_criterion_with_no_text_is_refused(self):
        # The text is what a reviewer judges the frames against; an id alone
        # says nothing, and a dropped entry could never be reported unclaimed.
        with self.assertRaises(ValueError):
            _checked_criteria({"AC-1": "   "})


class MergedCoverage(unittest.TestCase):
    def test_the_union_names_a_criterion_no_single_segment_could(self):
        # Neither segment's own report can say AC-3 is unclaimed, because
        # neither knows the other's criteria. The merged one can.
        docs = [
            {"coverage": {"criteria": {"AC-1": "web half", "AC-3": "cli half"}}},
            {"coverage": {"criteria": {"AC-2": "second half"}}},
        ]
        merged = _merged_coverage(docs, [beat(1, "caption", 1.0, ac=["AC-1"])])
        self.assertEqual(sorted(merged["criteria"]), ["AC-1", "AC-2", "AC-3"])
        self.assertEqual(sorted(merged["unclaimed"]), ["AC-2", "AC-3"])

    def test_segments_disagreeing_about_one_id_is_reported_not_resolved(self):
        docs = [
            {"coverage": {"criteria": {"AC-1": "the wording one segment used"}}},
            {"coverage": {"criteria": {"AC-1": "a different wording entirely"}}},
        ]
        merged = _merged_coverage(docs, [])
        self.assertEqual(merged["conflicts"], ["AC-1"])

    def test_agreeing_segments_produce_no_conflict_key(self):
        # The control for the test above: without it, a `conflicts` key that
        # was always present would satisfy that assertion on every input.
        docs = [
            {"coverage": {"criteria": {"AC-1": "same"}}},
            {"coverage": {"criteria": {"AC-1": "same"}}},
        ]
        self.assertNotIn("conflicts", _merged_coverage(docs, []))

    def test_first_wording_wins_in_the_map_when_segments_disagree(self):
        criteria, conflicts = _declared_criteria(
            [
                {"coverage": {"criteria": {"AC-1": "first"}}},
                {"coverage": {"criteria": {"AC-1": "second"}}},
            ]
        )
        self.assertEqual(criteria["AC-1"], "first")
        self.assertEqual(conflicts, ["AC-1"])



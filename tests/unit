# --------------------------------------------------------------------------
# Helpers — deliberately hand-written
# --------------------------------------------------------------------------
#
# `split_row` does NOT reuse `_md_cell`'s escaping, and that is the catalogue
# entry "the check that shares the bug's blind spot": a check that unescapes
# with the same helper the code escaped with agrees with that helper's bugs by
# construction. This one is written from the reader's side — what a markdown
# renderer does with a row — so a change to the escaping rule shows up here as
# a failure rather than as silence.


def split_row(line: str) -> list[str]:
    """A markdown table row split into cells, honouring backslash escapes."""
    cells: list[str] = []
    current: list[str] = []
    i = 0
    while i < len(line):
        ch = line[i]
        if ch == "\\" and i + 1 < len(line):
            current.append(line[i + 1])
            i += 2
            continue
        if ch == "|":
            cells.append("".join(current))
            current = []
            i += 1
            continue
        current.append(ch)
        i += 1
    cells.append("".join(current))
    return [c.strip() for c in cells[1:-1]] if len(cells) > 2 else []


def beat(index: int, verb: str, t_start: float, **extra: object) -> dict:
    doc = {
        "index": index,
        "verb": verb,
        "t_start": t_start,
        "t_end": t_start + 0.1,
        "caption": "",
        "selector": None,
        "segment": None,
        "segment_index": index,
    }
    doc.update(extra)
    return doc


def seg(name: str, **content: object) -> dict:
    base = {
        "measured": True,
        "score": 10.0,
        "static_for": 1.0,
        "frames": 10,
        "sample_fps": 2,
        "floor": 6.0,
        "static_limit": 15.0,
        "opening": None,
        "warnings": [],
    }
    base.update(content)
    return {"segment": name, "content": base}


def envelope(**over: object) -> dict:
    doc = {
        "schema": 1,
        "generated_by": "demo-video",
        "recorder": "Recorder",
        "segment": None,
        "media": "demo.mp4",
        "duration": 18.04,
        "strict": False,
        "issue_count": 0,
        "beats": [],
        "issues": [],
        "determinism": {
            "deterministic": False,
            "clock": None,
            "timezone_id": "UTC",
            "locale": "en-US",
        },
        "content": None,
        "coverage": None,
    }
    doc.update(over)
    return doc



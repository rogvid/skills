class SecretType(unittest.TestCase):
    def test_a_secret_is_not_a_str(self):
        # Deliberately not a str subclass: `_verb_target` picks the first
        # string argument of a verb as that beat's `selector`, so a
        # str-subclassed Secret handed to any verb would be written into
        # timeline.json verbatim — a file this skill tells people to commit.
        self.assertNotIsInstance(Secret("sk-live-abcdef123456"), str)

    def test_printing_a_secret_yields_the_mask_not_the_value(self):
        self.assertEqual(str(Secret("sk-live-abcdef123456")), SECRET_MASK)
        self.assertEqual(f"{Secret('sk-live-abcdef123456')}", SECRET_MASK)

    def test_repr_names_the_length_and_not_the_value(self):
        # A repr lands in tracebacks, CI logs and bug reports — the set of
        # places this type exists to keep the value out of.
        text = repr(Secret("sk-live-abcdef123456"))
        self.assertNotIn("sk-live", text)
        self.assertIn("20", text)

    def test_reveal_is_the_only_way_to_the_plaintext(self):
        self.assertEqual(
            Secret("sk-live-abcdef123456").reveal(), "sk-live-abcdef123456"
        )

    def test_an_empty_secret_is_refused(self):
        with self.assertRaises(ValueError):
            Secret("")


# --------------------------------------------------------------------------
# SKILL.md and its reference/ files (issue #140)
# --------------------------------------------------------------------------
#
# A skill's SKILL.md is loaded *whole* into the caller's context the moment the
# skill triggers; files it links are read on demand. That makes its length a
# cost every invocation pays, and it is why the reference material was moved
# out. These three assertions are what stop the move from silently undoing
# itself — a pointer that rots, a reference file nothing links, or a section
# that drifts back into the always-loaded file.


SKILL_DIR = Path(os.environ.get("UNIT_SKILL_DIR", REPO / "skills" / "demo-video"))

# Lines SKILL.md may occupy. It is 510 today. The headroom is for ordinary
# growth — a verb, a mistake worth naming — and the number is deliberately
# tight enough that a *section* cannot fit inside it. When this fails, the
# answer is almost never to raise it: it is to move the new material into
# reference/ and link it at the point of use.
SKILL_LINE_BUDGET = 600


class SkillDocs(unittest.TestCase):
    def setUp(self):
        self.skill = (SKILL_DIR / "SKILL.md").read_text(encoding="utf-8")

    def test_every_reference_link_in_skill_md_resolves(self):
        links = sorted(set(re.findall(r"\]\((reference/[^)#]+)", self.skill)))
        # The catalogue's "vacuous sweep": a link check over a file with no
        # links passes trivially. Assert the haystack first.
        self.assertGreaterEqual(len(links), 8, "SKILL.md links almost nothing")
        missing = [ln for ln in links if not (SKILL_DIR / ln).is_file()]
        self.assertEqual(missing, [], f"dead reference links: {missing}")

    def test_every_reference_file_is_linked_from_skill_md(self):
        # An unread reference is a deleted one. A file nothing points at is
        # not progressive disclosure, it is material that was removed.
        on_disk = {p.name for p in (SKILL_DIR / "reference").glob("*.md")}
        linked = set(re.findall(r"\]\(reference/([^)#]+)", self.skill))
        self.assertGreaterEqual(len(on_disk), 8)
        self.assertEqual(on_disk - linked, set(), "reference files nothing links")

    def test_skill_md_stays_inside_its_context_budget(self):
        lines = len(self.skill.splitlines())
        self.assertLessEqual(
            lines,
            SKILL_LINE_BUDGET,
            f"SKILL.md is {lines} lines against a {SKILL_LINE_BUDGET}-line "
            f"budget. Every caller pays for this file on every invocation — "
            f"move the new material into reference/ and link it at the point "
            f"of use rather than raising the budget.",
        )



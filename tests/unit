        with self.assertRaises(ValueError):
            _checked_criteria({"AC|1": "text"})

    def test_a_criterion_with_no_text_is_refused(self):
        # The text is what a reviewer judges the frames against; an id alone
        # says nothing, and a dropped entry could never be reported unclaimed.
        with self.assertRaises(ValueError):
            _checked_criteria({"AC-1": "   "})


class MergedCoverage(unittest.TestCase):
    def test_the_union_names_a_criterion_no_single_segment_could(self):
        # Neither segment's own report can say AC-3 is unclaimed, because
        # neither knows the other's criteria. The merged one can.
        docs = [
            {"coverage": {"criteria": {"AC-1": "web half", "AC-3": "cli half"}}},
            {"coverage": {"criteria": {"AC-2": "second half"}}},
        ]
        merged = _merged_coverage(docs, [beat(1, "caption", 1.0, ac=["AC-1"])])
        self.assertEqual(sorted(merged["criteria"]), ["AC-1", "AC-2", "AC-3"])
        self.assertEqual(sorted(merged["unclaimed"]), ["AC-2", "AC-3"])

    def test_segments_disagreeing_about_one_id_is_reported_not_resolved(self):
        docs = [
            {"coverage": {"criteria": {"AC-1": "the wording one segment used"}}},
            {"coverage": {"criteria": {"AC-1": "a different wording entirely"}}},
        ]
        merged = _merged_coverage(docs, [])
        self.assertEqual(merged["conflicts"], ["AC-1"])

    def test_agreeing_segments_produce_no_conflict_key(self):
        # The control for the test above: without it, a `conflicts` key that
        # was always present would satisfy that assertion on every input.
        docs = [
            {"coverage": {"criteria": {"AC-1": "same"}}},
            {"coverage": {"criteria": {"AC-1": "same"}}},
        ]
        self.assertNotIn("conflicts", _merged_coverage(docs, []))

    def test_first_wording_wins_in_the_map_when_segments_disagree(self):
        criteria, conflicts = _declared_criteria(
            [
                {"coverage": {"criteria": {"AC-1": "first"}}},
                {"coverage": {"criteria": {"AC-1": "second"}}},
            ]
        )
        self.assertEqual(criteria["AC-1"], "first")
        self.assertEqual(conflicts, ["AC-1"])



class OpeningWarning(unittest.TestCase):
    def test_a_recorder_that_never_held_does_not_warn(self):
        # `held: null` and `held: 0.0` are different answers — "never claimed
        # to" against "had nothing to cover" — and only the second can be a
        # defect. A terminal take reports null on every take; warning there
        # is exactly how a warning stops being read.
        self.assertIsNone(opening_warning(opening_report(2.0, None, None)))

    def test_a_recorder_that_held_and_still_opens_blank_warns(self):
        warning = opening_warning(opening_report(2.0, None, 0.0))
        self.assertIsNotNone(warning)
        self.assertIn("2.00s", warning)

    def test_the_warning_bar_is_graded_at_its_boundary(self):
        # The catalogue's "ungraded constant": test either side of
        # OPENING_WARN_S, not comfortably inside one of them.
        just_under = OPENING_WARN_S - 0.01
        self.assertIsNone(opening_warning(opening_report(just_under, None, 0.0)))
        self.assertIsNotNone(opening_warning(opening_report(OPENING_WARN_S, None, 0.0)))

    def test_a_healthy_take_whose_hold_landed_is_silent(self):
        self.assertIsNone(opening_warning(opening_report(0.0, None, 0.42)))


class BeatsWithin(unittest.TestCase):
    def test_a_beat_that_began_before_the_stretch_is_not_counted(self):
        # "Began, not overlapped", and the difference is the whole
        # correctness of the correlation: the verb immediately before a held
        # stretch is very often the thing that *ended* the previous one.
        found = _beats_within([beat(1, "run", 2.32)], 2.50, 9.0)
        self.assertEqual(found, [])

    def test_a_beat_that_began_inside_the_stretch_is_counted(self):
        found = _beats_within([beat(1, "run", 2.60)], 2.50, 9.0)
        self.assertEqual([b["index"] for b in found], [1])

    def test_an_acting_verb_and_a_narrating_one_are_told_apart(self):
        found = _beats_within(
            [
                beat(1, "caption", 3.0),
                beat(2, "click", 4.0),
                beat(3, "hold", 5.0),
                beat(4, "run", 6.0),
            ],
            2.0,
            9.0,
        )
        self.assertEqual(
            {b["verb"]: b["acting"] for b in found},
            {"caption": False, "click": True, "hold": False, "run": True},
        )

    def test_a_beat_with_no_usable_timestamp_is_skipped_not_crashed(self):
        self.assertEqual(_beats_within([{"index": 1, "verb": "run"}], 0.0, 9.0), [])


class ContentRect(unittest.TestCase):
    def test_the_caption_band_is_cut_off_the_bottom(self):
        _, _, _, h = content_rect((0, 0, 1280, 720))
        self.assertLess(h, 720)
        self.assertEqual(h, int(720 * (1.0 - CONTENT_CAPTION_TRIM)))

    def test_a_degenerate_rect_never_comes_back_zero_sized(self):
        # ffmpeg's crop filter fails on a zero dimension, and a measurement
        # must never be able to cost somebody a recording.
        _, _, w, h = content_rect((-5, -5, 0, 0))
        self.assertGreaterEqual(w, 2)
        self.assertGreaterEqual(h, 2)


class MergeContent(unittest.TestCase):
    """issue #121 — the 'worst of the segments' direction, which is opposite
    on the two arms: lowest score, longest held stretch."""

    def test_the_merged_score_is_the_lowest_of_the_segments(self):
        merged = merge_content([seg("a", score=14.0), seg("b", score=3.0)])
        self.assertEqual(merged["score"], 3.0)

    def test_the_merged_static_stretch_is_the_longest_of_the_segments(self):
        merged = merge_content([seg("a", static_for=4.0), seg("b", static_for=21.5)])
        self.assertEqual(merged["static_for"], 21.5)

    def test_a_segment_that_could_not_be_measured_lowers_nothing(self):
        merged = merge_content(
            [
                seg("a", score=14.0, static_for=4.0),
                seg("b", measured=False, score=None, static_for=None),
            ]
        )
        self.assertTrue(merged["measured"])
        self.assertEqual(merged["score"], 14.0)
        self.assertEqual(merged["static_for"], 4.0)

    def test_every_segments_warning_survives_tagged_with_its_segment(self):
        merged = merge_content(
            [
                seg("a", warnings=["the rect held one picture for 20.0s"]),
                seg("b", warnings=["there is no picture where the app should be"]),
            ]
        )
        self.assertEqual(len(merged["warnings"]), 2)
        self.assertTrue(merged["warnings"][0].startswith("segment 'a':"))
        self.assertTrue(merged["warnings"][1].startswith("segment 'b':"))

    def test_the_opening_is_the_first_segments_not_the_worst(self):
        # Only segment one's frame zero is the joined video's frame zero;
        # every other segment's opening lands mid-demo, where a blank frame
        # is a cut and not this phenomenon at all.
        first = opening_report(0.0, None, 0.4)
        second = opening_report(2.0, None, 0.0)
        merged = merge_content([seg("a", opening=first), seg("b", opening=second)])
        self.assertEqual(merged["opening"], first)

    def test_a_merged_demo_reports_no_single_rect_or_beat_index(self):
        # Two segments can be two media with two geometries, and the worst
        # run belongs to one segment's own clock and beat numbering.
        merged = merge_content([seg("a"), seg("b")])
        self.assertIsNone(merged["rect"])
        self.assertIsNone(merged["static_from"])
        self.assertIsNone(merged["static_beats"])

    def test_segments_disagreeing_on_a_floor_report_neither(self):
        merged = merge_content([seg("a", floor=6.0), seg("b", floor=2.0)])
        self.assertIsNone(merged["floor"])


